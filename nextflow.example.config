params {
    /* ------------------------------ Input/output --------------------------- */

    // Replace these paths with the location of your phased, indexed VCF files.
    input_pattern = '/path/to/phased_vcfs/chr{chr}.phased.vcf.gz'
    input_index_pattern = '/path/to/phased_vcfs/chr{chr}.phased.vcf.gz.tbi'

    chromosomes = 1..22
    outdir = 'results_2cM_Fst_0001'


    /* ------------------------------ Programs ------------------------------- */

    hapibd_jar = "${projectDir}/bin/hap-ibd.jar"
    per_pair_script = "${projectDir}/bin/IBD_per_pair.py"
    clustering_script = "${projectDir}/bin/cluster_ibd_graph.py"
    fst_clump_script = "${projectDir}/bin/fst_clump.py"
    final_ibd_script = "${projectDir}/bin/final_ibd_sharing.py"
    final_fst_heatmap_script = "${projectDir}/bin/final_fst_heatmap.py"
    ibdne_jar = "${projectDir}/bin/ibdne.23Apr20.ae9.jar"
    ibdne_runner_script = "${projectDir}/bin/run_ibdne_clusters.py"
    relatedness_selector_script = "${projectDir}/bin/relatedness_selector.py"

    // Replace this with a PLINK 2 module available on your computing system.
    plink2_module = 'plink/2.00-20231024-avx2'


    /* ------------------------ Python environment --------------------------- */

    // Replace this path with a Python environment containing python-igraph.
    python_venv = '/path/to/python_environment'


    /* ---------------------------- Genetic maps ----------------------------- */

    // The VCF CHROM field contains chr1, chr2, ..., chr22.
    chr_in_chrom_field = true


    /* ----------------------------- Genome gaps ----------------------------- */

    remove_gaps = true
    gap_file = "${projectDir}/assets/genome_gap_hg38_and_MHC.noheader.bed"


    /* -------------------------- Variant-level QC --------------------------- */

    qc {
        min_maf = 0.001

        // Hap-IBD requires complete genotypes at retained variants.
        max_variant_missingness = 0.0
    }


    /* ----------------------- Relatedness identification -------------------- */

    relatedness {
        /*
         * discover_apply:
         *   Perform KING and preliminary full-cohort Hap-IBD, generate the
         *   unrelated list, subset the VCFs, and continue with the final
         *   Hap-IBD, clustering and FST analyses.
         *
         * reuse:
         *   Skip relatedness discovery and use sample_list.
         *
         * disabled:
         *   Use the complete cohort for the final analyses.
         */
        mode = 'reuse'

        // Used only when mode = 'reuse'. Replace with your sample-list path.
        sample_list = '/path/to/unrelated.samples.txt'

        /*
         * optimal:
         *   Retain the largest practical mutually unrelated sample subset.
         *
         * remove_all:
         *   Remove every participant belonging to at least one related pair.
         */
        removal_mode = 'optimal'

        // KING threshold for approximately second-degree relatives or closer.
        king_cutoff = 0.0884

        // Flag pairs sharing strictly more than this total Hap-IBD length.
        ibd_total_cm_cutoff = 1000.0

        // Common-variant QC used specifically for KING.
        min_maf = 0.05
        max_variant_missingness = 0.01

        // PLINK 2 --indep-pairwise 50 10 0.1.
        prune_window_variants = 50
        prune_step_variants = 10
        prune_r2 = 0.1

        // Reproduce PLINK 1.x variant-pruning order.
        indep_order = 1
    }


    /* ------------- Preliminary full-cohort Hap-IBD for relatives ---------- */

    /*
     * This first Hap-IBD pass is only used to identify pairs sharing more
     * than relatedness.ibd_total_cm_cutoff.
     *
     * It is independent of the final clustering Hap-IBD parameters.
     */
    relatedness_hapibd {
        min_seed_cm = 2.0
        min_extend_cm = 1.0
        min_output_cm = 2.0
        min_markers = 200
        min_mac = 2
        max_gap_bp = 1000
    }


    /*
     * The relatedness selector uses total_IBD_length_cM, which includes every
     * segment emitted by relatedness_hapibd. This threshold only determines
     * the additional threshold-specific columns in the preliminary summary.
     */
    relatedness_summary {
        segment_threshold_cm = 2.0
    }


    /* ---------------- Final Hap-IBD used for clustering -------------------- */

    /*
     * This second Hap-IBD pass runs only on the selected unrelated cohort.
     *
     * Segments >=2 cM are detected, and clustering below uses the
     * threshold-specific total for segments >=2 cM.
     */
    hapibd {
        min_seed_cm = 2.0
        min_extend_cm = 1.0
        min_output_cm = 2.0
        min_markers = 200
        min_mac = 2
        max_gap_bp = 1000
    }


    /* -------------------------- Final pair summary ------------------------- */

    summary {
        /*
         * This produces columns including:
         *
         * number_of_segments_ge_2_cM
         * total_length_of_segments_ge_2_cM
         */
        segment_threshold_cm = 2.0
    }


    /* ----------------------------- Clustering ------------------------------ */

    Louvain = true
    Leiden = true

    // Run exactly three recursive refinement levels.
    n_louvain = 3
    n_leiden = 3

    clustering {
        /*
         * Although the final Hap-IBD pass outputs segments >=2 cM, graph
         * weights are calculated using only segments >=2 cM.
         */
        weight_column = 'total_length_of_segments_ge_2_cM'

        /*
         * Communities smaller than 20 remain in the membership output but are
         * not submitted to another recursive subdivision.
         */
        min_cluster_size = 20

        // Fixed-depth clustering without modularity-based early stopping.
        min_modularity_gain = 0.0
        auto_select = false

        leiden_resolution = 1.0
        seed = 2026
    }


    /* -------------------------- FST preparation/clumping ------------------- */

    fst {
        enabled = true

        /*
         * FST is estimated from common, autosomal, biallelic SNPs after the
         * VCFs have been restricted to the unrelated cohort.
         */
        min_maf = 0.05
        max_variant_missingness = 0.01

        /*
         * Lenient pooled-cohort HWE filtering intended to remove only extreme
         * technical failures while limiting removal due to population
         * structure.
         */
        hwe_pvalue = 1e-12

        // PLINK 2 --indep-pairwise 1000kb 1 0.1.
        prune_window_kb = 1000
        prune_step_variants = 1
        prune_r2 = 0.1

        // Terminal clustering level supplied to fst_clump.py.
        cluster_column = 'level_3'

        /*
         * Iteratively merge the eligible pair with the lowest Hudson FST and
         * stop when every eligible pair has FST >=0.001.
         */
        clump_threshold = 0.001

        /*
         * Terminal clusters smaller than 15 remain unchanged and are not
         * submitted to FST-based clumping.
         */
        min_cluster_size = 15
    }


    /* ---------------- Final-cluster effective population size ------------- */

    ibdne {
        enabled = true

        // Final clusters below this size are retained but skipped by IBDNe.
        min_cluster_size = 20

        // IBDNe estimation and bootstrap parameters.
        mincm = 2.0
        nits = 1000
        nboots = 80
        filtersamples = false
        seed = 2026

        // Run this many cluster-level IBDNe analyses concurrently per method.
        parallel_clusters = 2

        // Maximum Java heap assigned to each concurrent IBDNe analysis.
        java_heap_gb = 24
    }


    /* ------------------------------ Resources ------------------------------ */

    resources {
        qc {
            cpus = 2
            memory = '4 GB'
            time = '1h'
        }

        // Preliminary full-cohort Hap-IBD pass for relatedness discovery.
        relatedness_hapibd {
            cpus = 8
            memory = '175 GB'
            time = '2h'
        }

        // Final unrelated-cohort Hap-IBD pass used for clustering.
        hapibd {
            cpus = 8
            memory = '175 GB'
            time = '2h'
        }

        // Common-SNP preparation, LD pruning and KING calculation.
        relatedness_king {
            cpus = 8
            memory = '64 GB'
            time = '12h'
        }

        // Combine KING and Hap-IBD evidence and select unrelated samples.
        relatedness_select {
            cpus = 1
            memory = '16 GB'
            time = '2h'
        }

        // Chromosome-specific and genome-wide IBD summaries.
        summary {
            cpus = 1
            memory = '12 GB'
            time = '6h'
        }

        // Louvain and Leiden graph clustering.
        clustering {
            cpus = 4
            memory = '64 GB'
            time = '4h'
        }

        // Concatenation, PGEN conversion, QC and LD pruning for FST.
        fst_prepare {
            cpus = 8
            memory = '8 GB'
            time = '2h'
        }

        // Repeated PLINK 2 Hudson FST calculations during clumping.
        fst_clump {
            cpus = 8
            memory = '4 GB'
            time = '2h'
        }

        final_ibd {
            cpus = 1
            memory = '16 GB'
            time = '6h'
        }

        final_fst {
            cpus = 8
            memory = '32 GB'
            time = '12h'
        }

        ibdne {
            cpus = 16
            memory = '64 GB'
            time = '48h'
        }
    }
}


process {
    executor = 'slurm'
    clusterOptions = ''
}


executor {
    queueSize = 300
    queueStatInterval = '3min'
    submitRateLimit = '10 sec'
}

params {
   workingDir = "path/to/workingdir"
   genoFile = "path/to/genotypeFile/*.vcf.gz" //need to be zipped <bgzip file>
   virtualenv = "path/to/virtualenv/bin/activate"
   beagleDir = "path/to/Beaglephasing.jar"  
   phaseibd = "path/to/phaseibd/phaseibd_chr.py"
   hapibd = "path/to/hap-ibd.jar"
   geneticMap = "/path/to/geneticMap" //.map format prefered, make sure to match the chromosome prefix with the genotype file
   gapfile = "/path/t0/*.bed"   //bed file of regions to remove from the IBD analysis
   phasingStep = "0 or 1"  //0 means that you skip the phasing step and 1 you go through phasing with Beagle
   chromosomePrefix = "0 or 1" //chr in front of your vcf CHROM field?
   removeGaps = "0 or 1" //do you want to remove the gaps that are in the bed files from the IBD segments (1 = yes, 0 = no)
   chromosomes = ["chr1", "chr2", "chr3", "chr4", "chr5", "chr6", "chr7", "chr8", "chr9", "chr10", "chr11", "chr12", "chr13", "chr14", "chr15", "chr16", "chr17", "chr18", "chr19", "chr20", "chr21", "chr22"]
}

timeline {
  enabled = true
  file = "$PWD/timeline.html"
}

process {
   executor = "slurm"
   clusterOptions = "" // cluster allocation account name
   //executor = "local"
}

executor {
   $slurm {
      queueSize = 100
      queueStatInterval = "3min"
      submitRateLimit = "10 sec"
      jobName = { "IBD" }
   }
   
   $local {
      cpus = 1
   }
}

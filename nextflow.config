params {
   workingDir = "path/to/workingdir"
   genoFile = "path/to/genotypeFile/genotype.vcf.gz" //need to be zipped <bgzip file>
   virtualenv = "path/to/virtualenv/bin/activate"
   beagleDir = "path/to/Beaglephasing.jar"  
   phaseibd = "path/to/phaseibd/phaseibd_chr.py"
   hapibd = "path/to/hapibd"
   geneticMap = "/path/to/geneticMap"
   gapfile = "/path/t0/file.bed"   //bed file of regions to remove from the IBD analysis
   phasingStep = "0 or 1"  //0 means that you skip the phasing step and 1 you go through phasing with Beagle
   chromosomePrefix = "True/False" //chr in front of your vcf CHROM field?
}

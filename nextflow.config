params {
    /* ------------------------------ Input/output --------------------------- */

    // Chromosome-split, bgzip-compressed and phased VCFs. The {chr}
    // placeholder may occur anywhere in the path or filename.
    input_pattern = '/path/to/project/private/cohort/genotypes/phased/chr{chr}.phased.vcf.gz'
    input_index_pattern = '/path/to/project/private/cohort/genotypes/phased/chr{chr}.phased.vcf.gz.tbi'
    chromosomes = 1..22
    outdir = 'results'


    /* ------------------------------ Programs ------------------------------- */

    // Programs and softwares needed by the pipeline, made available in the bin
    // Leave unchanged except if you want to use your versions of hap-IBD or custom scripts
    hapibd_jar = "${projectDir}/bin/hap-ibd.jar"
    per_pair_script = "${projectDir}/bin/IBD_per_pair.py"
    clustering_script = "${projectDir}/bin/cluster_ibd_graph.py"


    /* ------------------------ Python environment --------------------------- */

    // The environment must contain python-igraph.
    // The per-pair script otherwise uses only the Python standard library.
    python_venv = '/path/to/shared/virtualenv_python_3.14.2'


    /* ---------------------------- Genetic maps ----------------------------- */

    // Set this according to the chromosome identifiers stored in the VCF
    // CHROM field—not merely according to the VCF filenames.
    //
    // true:
    //     VCF chromosome identifiers are chr1, chr2, ..., chr22.
    //     The pipeline uses:
    //     assets/chr_in_chrom_field/plink.chrchrN.GRCh38.map
    //
    // false:
    //     VCF chromosome identifiers are 1, 2, ..., 22.
    //     The pipeline uses:
    //     assets/no_chr_in_chrom_field/plink.chrN.GRCh38.map
    chr_in_chrom_field = true


    /* ----------------------------- Genome gaps ----------------------------- */

    // Single BED file containing gaps for all chromosomes.
    // The fourth column is permitted but is not used for overlap filtering.
    remove_gaps = true
    gap_file = "${projectDir}/assets/genome_gap_hg38_and_MHC.noheader.bed"


    /* -------------------------- Variant-level QC --------------------------- */

    qc {
        min_maf = 0.001

        // Hap-IBD requires non-missing genotypes. A value above zero is only
        // valid if all variants retained after QC still have complete GTs.
        max_variant_missingness = 0.0
    }


    /* ---------------------------- Hap-IBD options -------------------------- */

    hapibd {
        min_seed_cm = 2.0
        min_extend_cm = 1.0
        min_output_cm = 3.0
        min_markers = 200
        min_mac = 2
        max_gap_bp = 1000
    }


    /* -------------------------- Per-pair summary --------------------------- */

    summary {
        // Count and sum segments greater than or equal to this threshold.
        segment_threshold_cm = 5.0
    }


    /* ----------------------------- Clustering ------------------------------ */

    Louvain = true
    Leiden = true

    n_louvain = 3
    n_leiden = 3

    clustering {
        // Specify which column from the genome-wide per-pair summary is used
        // as the graph edge weight. Larger values represent stronger sharing.
        //
        // Available examples:
        //
        // 'total_IBD_length_cM'
        //     Total length of all IBD segments shared by the pair.
        //     Recommended because it captures the overall amount of sharing.
        //
        // 'number_of_IBD_segments'
        //     Total number of IBD segments shared by the pair.
        //
        // 'mean_IBD_length_cM'
        //     Mean length of the pair's IBD segments.
        //
        // 'max_IBD_length_cM'
        //     Length of the longest segment shared by the pair.
        //
        // 'number_of_segments_ge_5_cM'
        //     Number of segments greater than or equal to the threshold in
        //     summary.segment_threshold_cm.
        //
        // 'total_length_of_segments_ge_5_cM'
        //     Total length of segments greater than or equal to the configured
        //     threshold.
        weight_column = 'total_IBD_length_cM'

        // Communities smaller than this remain in the output but are not
        // submitted to another recursive refinement level.
        min_cluster_size = 20

        // When auto_select=true, stop after a level whose global weighted
        // modularity gain is smaller than this value.
        min_modularity_gain = 0.0001
        auto_select = true

        leiden_resolution = 1.0
        seed = 2026
    }


    /* ------------------------------ Resources ------------------------------ */

    resources {
        qc {
            cpus = 2
            memory = '8 GB'
            time = '2h'
        }

        hapibd {
            cpus = 8
            memory = '175 GB'
            time = '2h'
        }

        summary {
            cpus = 1
            memory = '16 GB'
            time = '6h'
        }

        clustering {
            cpus = 4
            memory = '124 GB'
            time = '8h'
        }
    }
}


process {
    executor = 'slurm'

    // Add the allocation here if required by the cluster, for example:
    // clusterOptions = '--account=<allocation-name>'
    clusterOptions = ''
}


executor {
    queueSize = 300
    queueStatInterval = '3min'
    submitRateLimit = '10 sec'
}

params {
   workingDir = "path/to/workingdir"
   genoFile = "path/to/genotypeFile/*.vcf.gz"       //need to be zipped <bgzip file>
   virtualenv = "path/to/virtualenv/bin/activate"
   beagleDir = "path/to/Beaglephasing.jar"          //In the bin directory
   phaseibd = "path/to/phaseibd/phaseibd_chr.py"    //In the bin directory
   hapibd = "path/to/hap-ibd.jar"                   //In the bin directory
   geneticMap = "/path/to/geneticMap"               //.gmap format, make sure to match the chromosome prefix with the genotype file (HapMap gmaps available the bin/Hapmap directory)
   gapfile = "/path/to/gap.bed"                    //bed file of regions to remove from the IBD analysis
   phasingStep = true or false                   //false means that you skip the phasing step and true you go through phasing with Beagle
   chromosomePrefix = true or false"             //chr in front of your vcf CHROM field?
   removeGaps = true or false                   //do you want to remove the gaps that are in the bed files from the IBD segments (true = yes, false = no)
   chromosomes = Channel.of(1..22)
   
   //chromosomes = ["chr1", "chr2", "chr3", "chr4", "chr5", "chr6", "chr7", "chr8", "chr9", "chr10", "chr11", "chr12", "chr13", "chr14", "chr15", "chr16", "chr17", "chr18", "chr19", "chr20", "chr21", "chr22"]

}


process {
   executor = "slurm"
   clusterOptions = "" // cluster allocation account name
   //executor = "local"
   
   cpus = 8
   time = "12h"
   memory = "20GB"
   
   container = ' '
   docker.enabled = True
}

executor {
   $slurm {
      queueSize = 100
      queueStatInterval = "3min"
      submitRateLimit = "10 sec"
      jobName = { "IBD" }
   }
   
}

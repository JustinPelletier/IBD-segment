params {
    /* ------------------------------ Input/output --------------------------- */

    // Chromosome-split, bgzip-compressed and phased VCFs. The {chr}
    // placeholder may occur anywhere in the path or filename.
    input_pattern = '/path/to/data/cohort.chr{chr}.vcf.gz'
    chromosomes = 1..22
    outdir = 'results'

    /* ------------------------------ Programs ------------------------------- */

    hapibd_jar = "${projectDir}/bin/hap-ibd.jar"
    per_pair_script = "${projectDir}/bin/IBD_per_pair.py"
    clustering_script = "${projectDir}/bin/cluster_ibd_graph.py"

    /* ------------------------ Python environment ------------------------- */

    // The environment must contain python-igraph.
    // The per-pair script otherwise uses only the Python standard library.
    python_venv = "${System.getenv('HOME')}/virtualenvs/ibd_pipeline"

    /* ---------------------------- Genetic maps ----------------------------- */

    assembly = 'GRCh38'

    // The chromosome naming convention in the map must match the VCF.
    // Both prefixed (chr1) and unprefixed (1) HapMap files are in bin/HapMap.
    genetic_map_pattern = "${projectDir}/bin/HapMap/GRCh38/no_chr.chr{chr}.GRCh38.gmap"

    // Generate a marker-matched map for each QC-filtered VCF using PLINK.
    // If false, genetic_map_pattern is supplied directly to Hap-IBD.
    generate_custom_maps = true

    /* ----------------------------- Genome gaps ----------------------------- */

    // Single BED file containing gaps for all chromosomes.
    // The fourth column is permitted but is not used for overlap filtering.
    gap_file = "${projectDir}/assets/genome_gap_hg38_and_MHC.noheader.bed"

    // Internal empty BED used to maintain a consistent channel structure when
    // remove_gaps=false. This normally does not need to be changed.
    empty_gap_file = "${projectDir}/assets/empty.gap.bed"

    /* -------------------------- Variant-level QC --------------------------- */

    qc {
        min_maf = 0.001

        // Hap-IBD requires non-missing genotypes. A value above zero is only
        // valid if all variants retained after QC still have complete GTs.
        max_variant_missingness = 0.0
    }

    /* ---------------------------- Hap-IBD options -------------------------- */

    hapibd {
        min_seed_cm = 2.0
        min_extend_cm = 1.0
        min_output_cm = 3.0
        min_markers = 200
        min_mac = 2
        max_gap_bp = 1000
    }

    /* -------------------------- Per-pair summary --------------------------- */

    summary {
        // Count and sum segments greater than or equal to this threshold.
        segment_threshold_cm = 5.0
    }

    /* ----------------------------- Clustering ------------------------------ */

    Louvain = true
    Leiden = true

    // Specify which column from the genome-wide per-pair summary is used as
    // the graph edge weight. Larger values represent stronger IBD sharing.
    //
    // Available values:
    //
    // 'total_IBD_length_cM'
    //     Total length of all IBD segments shared by the pair.
    //     Recommended default because it captures the overall amount of IBD sharing.
    //
    // 'number_of_IBD_segments'
    //     Total number of IBD segments shared by the pair.
    //     Gives the same importance to every segment regardless of its length.
    //
    // 'mean_IBD_length_cM'
    //     Mean length of the pair's IBD segments.
    //     Emphasizes pairs sharing longer segments but does not account for the
    //     total number of segments.
    //
    // 'max_IBD_length_cM'
    //     Length of the longest IBD segment shared by the pair.
    //     Emphasizes evidence of a relatively recent common ancestor.
    //
    // 'number_of_segments_ge_5_cM'
    //     Number of shared segments greater than or equal to the threshold defined
    //     by summary.segment_threshold_cm. The exact column name changes when the
    //     configured threshold changes.
    //
    // 'total_length_of_segments_ge_5_cM'
    //     Total length of segments greater than or equal to the configured
    //     threshold. Useful for reducing the influence of shorter, potentially
    //     less reliable segments. The exact column name changes with the threshold.
    //
    // Although technically accepted, 'min_IBD_length_cM' and 'sd_IBD_length_cM'
    // are generally not meaningful measures of overall pairwise IBD sharing and
    // are not recommended as graph edge weights.
    weight_column = 'total_IBD_length_cM'
    
    n_louvain = 3
    n_leiden = 3

    clustering {
        // Specify what column of the per_pair summary stats file is used to
        // create edges in the graph 
        weight_column = 'total_IBD_length_cM'

        // Communities smaller than this remain in the output but are not
        // submitted to another recursive refinement level.
        min_cluster_size = 20

        // When auto_select=true, stop after a level whose global weighted
        // modularity gain is smaller than this value.
        min_modularity_gain = 0.0001
        auto_select = true

        leiden_resolution = 1.0
        seed = 2026
    }

    /* ------------------------------ Resources ------------------------------ */

    resources {
        qc {
            cpus = 2
            memory = '8 GB'
            time = '2h'
        }

        map {
            cpus = 1
            memory = '8 GB'
            time = '2h'
        }

        hapibd {
            cpus = 8
            memory = '175 GB'
            time = '4h'
        }

        summary {
            cpus = 1
            memory = '8 GB'
            time = '12h'
        }

        clustering {
            cpus = 4
            memory = '32 GB'
            time = '12h'
        }
    }
}


process {
    executor = 'slurm'

    // Add the allocation here if required by the cluster, for example:
    // clusterOptions = '--account=ctb-hussinju'
    clusterOptions = ''
}

executor {
    queueSize = 300
    queueStatInterval = '3min'
    submitRateLimit = '10 sec'
}

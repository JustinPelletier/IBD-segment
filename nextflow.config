params {
    /* ------------------------------ Input/output --------------------------- */

    // Replace these paths with chromosome-split, phased VCFs and indexes.
    // The {chr} placeholder is replaced by each value in chromosomes.
    input_pattern = '/path/to/phased_vcfs/chr{chr}.phased.vcf.gz'
    input_index_pattern = '/path/to/phased_vcfs/chr{chr}.phased.vcf.gz.tbi'
    chromosomes = 1..22
    outdir = 'results_3cM_Fst_0001'


    /* ------------------------------ Programs ------------------------------- */

    hapibd_jar = "${projectDir}/bin/hap-ibd.jar"
    per_pair_script = "${projectDir}/bin/IBD_per_pair.py"
    clustering_script = "${projectDir}/bin/cluster_ibd_graph.py"
    fst_clump_script = "${projectDir}/bin/fst_clump.py"
    final_ibd_script = "${projectDir}/bin/final_ibd_sharing.py"
    final_fst_heatmap_script = "${projectDir}/bin/final_fst_heatmap.py"
    relatedness_selector_script = "${projectDir}/bin/relatedness_selector.py"

    // Replace this value with a module supplying a recent PLINK 2 executable
    // with PGEN, KING and --fst support on your computing environment.
    plink2_module = 'plink/2.00-20231024-avx2'


    /* ------------------------ Python environment --------------------------- */

    // The environment must contain python-igraph. The per-pair and FST-clumping
    // scripts otherwise use only the Python standard library.
    python_venv = "/path/to/python_virtualenv"


    /* ---------------------------- Genetic maps ----------------------------- */

    // The VCF CHROM field contains chr1, chr2, ..., chr22.
    chr_in_chrom_field = true


    /* ----------------------------- Genome gaps ----------------------------- */

    remove_gaps = true
    gap_file = "${projectDir}/assets/genome_gap_hg38_and_MHC.noheader.bed"


    /* -------------------------- Variant-level QC --------------------------- */

    qc {
        min_maf = 0.001
        max_variant_missingness = 0.0
    }


    /* -------------------------- Relatedness filtering --------------------- */

    relatedness {
        // discover_apply:
        //   In one pipeline run, perform full-cohort KING and preliminary
        //   Hap-IBD, create the unrelated list, subset the VCFs, and then run
        //   the final Hap-IBD, Louvain, Leiden and FST analyses.
        //
        // reuse:
        //   Skip discovery and apply an existing sample_list.
        //
        // disabled:
        //   Run every analysis on the complete cohort.
        mode = 'discover_apply'

        // Used only in reuse mode.
        sample_list = null

        // optimal: retain the largest practical mutually unrelated subset.
        // remove_all: remove everyone belonging to at least one flagged pair.
        removal_mode = 'optimal'

        king_cutoff = 0.0884
        ibd_total_cm_cutoff = 1000.0

        // Common-SNP QC and LD pruning used specifically for KING.
        min_maf = 0.05
        max_variant_missingness = 0.01
        prune_window_variants = 50
        prune_step_variants = 10
        prune_r2 = 0.1

        // Reproduce PLINK 1.x pruning order, as used by older analyses.
        indep_order = 1

    }


    /* ---------------- Preliminary Hap-IBD for relatedness ---------------- */

    // This first Hap-IBD run uses the complete cohort. Its only purpose is to
    // identify pairs sharing more than relatedness.ibd_total_cm_cutoff.
    relatedness_hapibd {
        min_seed_cm = 2.0
        min_extend_cm = 1.0
        min_output_cm = 2.0
        min_markers = 200
        min_mac = 2
        max_gap_bp = 1000
    }

    relatedness_summary {
        // Selection uses total_IBD_length_cM, containing all segments emitted
        // by relatedness_hapibd. This threshold only names auxiliary columns.
        segment_threshold_cm = 2.0
    }


    /* ------------------ Final Hap-IBD used for clustering ----------------- */

    hapibd {
        min_seed_cm = 2.0
        min_extend_cm = 1.0
        // Retain segments >=2 cM; clustering uses the >=3 cM summary column.
        min_output_cm = 2.0
        min_markers = 200
        min_mac = 2
        max_gap_bp = 1000
    }


    /* -------------------------- Per-pair summary --------------------------- */

    summary {
        segment_threshold_cm = 3.0
    }


    /* ----------------------------- Clustering ------------------------------ */

    Louvain = true
    Leiden = true

    // The revised clustering script will run exactly three refinement levels.
    n_louvain = 3
    n_leiden = 3

    clustering {
        weight_column = 'total_length_of_segments_ge_3_cM'

        // Communities smaller than 20 remain in the membership output but are
        // carried forward without further recursive subdivision.
        min_cluster_size = 20

        // Disable modularity-based early stopping and selection. These values
        // remain present until the corresponding legacy CLI arguments are
        // removed from CLUSTER_GRAPH and cluster_ibd_graph.py.
        min_modularity_gain = 0.0
        auto_select = false

        leiden_resolution = 1.0
        seed = 2026
    }


    /* -------------------------- FST preparation/clumping ------------------- */

    fst {
        enabled = true

        // FST is estimated from common, autosomal, biallelic SNPs independently
        // of the less restrictive QC dataset used for Hap-IBD.
        min_maf = 0.05
        max_variant_missingness = 0.01

        // This deliberately lenient pooled-cohort HWE threshold removes only
        // extreme technical failures while limiting removal caused by genuine
        // population structure (the Wahlund effect).
        hwe_pvalue = 1e-12

        // PLINK 2 --indep-pairwise: window in kb, variant step, and r-squared.
        prune_window_kb = 1000
        prune_step_variants = 1
        prune_r2 = 0.1

        // The updated clustering script must always emit this terminal column.
        cluster_column = 'level_3'

        // Iteratively merge the lowest eligible pair, recalculate Hudson FST,
        // and stop when all eligible pairwise values are at least 0.001.
        clump_threshold = 0.001

        // Smaller terminal clusters remain unchanged and are not FST-clumped.
        min_cluster_size = 15
    }


    /* ------------------------------ Resources ------------------------------ */

    resources {
        qc {
            cpus = 2
            memory = '4 GB'
            time = '1h'
        }

        // Preliminary full-cohort 2 cM Hap-IBD pass.
        relatedness_hapibd {
            cpus = 8
            memory = '175 GB'
            time = '2h'
        }

        // Final unrelated-cohort Hap-IBD pass.
        hapibd {
            cpus = 8
            memory = '175 GB'
            time = '2h'
        }

        summary {
            cpus = 1
            memory = '12 GB'
            time = '6h'
        }

        clustering {
            cpus = 4
            memory = '64 GB'
            time = '4h'
        }


        // Common-SNP preparation, LD pruning and KING calculation.
        relatedness_king {
            cpus = 8
            memory = '64 GB'
            time = '12h'
        }

        // Combines the KING and Hap-IBD pair tables. The IBD table is streamed,
        // so memory is driven mainly by the relatively small related-pair graph.
        relatedness_select {
            cpus = 1
            memory = '16 GB'
            time = '2h'
        }

        // Concatenation, PGEN conversion, QC, and LD pruning.
        fst_prepare {
            cpus = 8
            memory = '8 GB'
            time = '2h'
        }

        // Repeated PLINK 2 Hudson FST calculations during iterative clumping.
        fst_clump {
            cpus = 8
            memory = '4 GB'
            time = '2h'
        }

        // One streaming pass over the genome-wide pair table per method.
        final_ibd {
            cpus = 1
            memory = '16 GB'
            time = '6h'
        }

        // One final PLINK 2 Hudson FST calculation per method.
        final_fst {
            cpus = 8
            memory = '32 GB'
            time = '12h'
        }
    }
}


process {
    executor = 'slurm'
    clusterOptions = ''
}


executor {
    queueSize = 300
    queueStatInterval = '3min'
    submitRateLimit = '10 sec'
}

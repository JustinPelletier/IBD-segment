params {
    /* ------------------------------ Input/output --------------------------- */

    // Chromosome-split, bgzip-compressed and phased VCFs. The {chr}
    // placeholder may occur anywhere in the path or filename.
    input_pattern = '/path/to/project/private/cohort/genotypes/phased/chr{chr}.phased.vcf.gz'
    input_index_pattern = '/path/to/project/private/cohort/genotypes/phased/chr{chr}.phased.vcf.gz.tbi'
    chromosomes = 1..22
    outdir = 'results'


    /* ------------------------------ Programs ------------------------------- */

    // Programs and softwares needed by the pipeline, made available in the bin
    // Leave unchanged except if you want to use your versions of hap-IBD or custom scripts
    hapibd_jar = "${projectDir}/bin/hap-ibd.jar"
    per_pair_script = "${projectDir}/bin/IBD_per_pair.py"
    clustering_script = "${projectDir}/bin/cluster_ibd_graph.py"
    fst_clump_script = "${projectDir}/bin/fst_clump.py"

    // Replace this value with a Narval module that supplies a recent `plink2`
    // executable with support for `--fst` and PGEN files.
    // Check available versions with: module spider plink
    plink2_module = 'plink/2.00-20231024-avx2'



    /* ------------------------ Python environment --------------------------- */

    // The environment must contain python-igraph.
    // The per-pair script otherwise uses only the Python standard library.
    python_venv = '/path/to/shared/virtualenv_python_3.14.2'


    /* ---------------------------- Genetic maps ----------------------------- */

    // Set this according to the chromosome identifiers stored in the VCF
    // CHROM field—not merely according to the VCF filenames.
    //
    // true:
    //     VCF chromosome identifiers are chr1, chr2, ..., chr22.
    //     The pipeline uses:
    //     assets/chr_in_chrom_field/plink.chrchrN.GRCh38.map
    //
    // false:
    //     VCF chromosome identifiers are 1, 2, ..., 22.
    //     The pipeline uses:
    //     assets/no_chr_in_chrom_field/plink.chrN.GRCh38.map
    chr_in_chrom_field = true


    /* ----------------------------- Genome gaps ----------------------------- */

    // Single BED file containing gaps for all chromosomes.
    // The fourth column is permitted but is not used for overlap filtering.
    remove_gaps = true
    gap_file = "${projectDir}/assets/genome_gap_hg38_and_MHC.noheader.bed"


    /* -------------------------- Variant-level QC --------------------------- */

    qc {
        min_maf = 0.001

        // Hap-IBD requires non-missing genotypes. A value above zero is only
        // valid if all variants retained after QC still have complete GTs.
        max_variant_missingness = 0.0
    }


    /* ---------------------------- Hap-IBD options -------------------------- */

    hapibd {
        min_seed_cm = 2.0
        min_extend_cm = 1.0
        min_output_cm = 3.0
        min_markers = 200
        min_mac = 2
        max_gap_bp = 1000
    }


    /* -------------------------- Per-pair summary --------------------------- */

    summary {
        // Count and sum segments greater than or equal to this threshold.
        segment_threshold_cm = 5.0
    }


   
    /* ---------------------------- Hap-IBD options -------------------------- */

    hapibd {
        min_seed_cm = 2.0
        min_extend_cm = 1.0
        min_output_cm = 2.0
        min_markers = 200
        min_mac = 2
        max_gap_bp = 1000
    }


    /* -------------------------- Per-pair summary --------------------------- */

    summary {
        segment_threshold_cm = 5.0
    }


    /* ----------------------------- Clustering ------------------------------ */

    Louvain = true
    Leiden = true

    // The revised clustering script will run exactly three refinement levels.
    n_louvain = 3
    n_leiden = 3

    clustering {
        // Specify which column from the genome-wide per-pair summary is used
        // as the graph edge weight. Larger values represent stronger sharing.
        //
        // Available examples:
        //
        // 'total_IBD_length_cM'
        //     Total length of all IBD segments shared by the pair.
        //     Recommended because it captures the overall amount of sharing.
        //
        // 'number_of_IBD_segments'
        //     Total number of IBD segments shared by the pair.
        //
        // 'mean_IBD_length_cM'
        //     Mean length of the pair's IBD segments.
        //
        // 'max_IBD_length_cM'
        //     Length of the longest segment shared by the pair.
        //
        // 'number_of_segments_ge_5_cM'
        //     Number of segments greater than or equal to the threshold in
        //     summary.segment_threshold_cm.
        //
        // 'total_length_of_segments_ge_5_cM'
        //     Total length of segments greater than or equal to the configured
        //     threshold.
        weight_column = 'total_IBD_length_cM' //'total_IBD_length_x_mean_IBD_length_cM2'

        // Communities smaller than 20 remain in the membership output but are
        // carried forward without further recursive subdivision.
        min_cluster_size = 20

        // Disable modularity-based early stopping and selection. These values
        // remain present until the corresponding legacy CLI arguments are
        // removed from CLUSTER_GRAPH and cluster_ibd_graph.py.
        min_modularity_gain = 0.0
        auto_select = false

        leiden_resolution = 1.0
        seed = 2026
    }


    /* -------------------------- FST preparation/clumping ------------------- */

    fst {
        enabled = true

        // FST is estimated from common, autosomal, biallelic SNPs independently
        // of the less restrictive QC dataset used for Hap-IBD.
        min_maf = 0.05
        max_variant_missingness = 0.01

        // This deliberately lenient pooled-cohort HWE threshold removes only
        // extreme technical failures while limiting removal caused by genuine
        // population structure (the Wahlund effect).
        hwe_pvalue = 1e-12

        // PLINK 2 --indep-pairwise: window in kb, variant step, and r-squared.
        prune_window_kb = 1000
        prune_step_variants = 1
        prune_r2 = 0.1

        // The updated clustering script must always emit this terminal column.
        cluster_column = 'level_3'

        // Iteratively merge the lowest eligible pair, recalculate Hudson FST,
        // and stop when all eligible pairwise values are at least 0.0005.
        clump_threshold = 0.0005

        // Smaller terminal clusters remain unchanged and are not FST-clumped.
        min_cluster_size = 15
    }


    /* ------------------------------ Resources ------------------------------ */

    resources {
        qc {
            cpus = 2
            memory = '8 GB'
            time = '2h'
        }

        hapibd {
            cpus = 8
            memory = '175 GB'
            time = '2h'
        }

        summary {
            cpus = 1
            memory = '8 GB'
            time = '4h'
        }

        clustering {
            cpus = 4
            memory = '86 GB'
            time = '4h'
        }

        // Concatenation, PGEN conversion, QC, and LD pruning.
        fst_prepare {
            cpus = 8
            memory = '4 GB'
            time = '2h'
        }

        // Repeated PLINK 2 Hudson FST calculations during iterative clumping.
        fst_clump {
            cpus = 8
            memory = '12 GB'
            time = '2h'
        }
    }
}

process {
    executor = 'slurm'

    // Add the allocation here if required by the cluster, for example:
    // clusterOptions = '--account=<allocation-name>'
    clusterOptions = ''
}


executor {
    queueSize = 300
    queueStatInterval = '3min'
    submitRateLimit = '10 sec'
}
